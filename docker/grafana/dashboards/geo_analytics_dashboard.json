          "pluginVersion": "4.16.0",
          "queryType": "timeseries",
          "rawSql": "SELECT \r\n    multiIf(\r\n        toDayOfWeek(timestamp) = 1, '1-ПН',\r\n        toDayOfWeek(timestamp) = 2, '2-ВТ',\r\n        toDayOfWeek(timestamp) = 3, '3-СР',\r\n        toDayOfWeek(timestamp) = 4, '4-ЧТ',\r\n        toDayOfWeek(timestamp) = 5, '5-ПТ',\r\n        toDayOfWeek(timestamp) = 6, '6-СБ',\r\n        '7-ВС'\r\n    ) AS \"День недели\",\r\n    \r\n    concat(toString(toHour(timestamp)), ':00') AS \"Час\",\r\n    \r\n    count(DISTINCT imsi) AS value\r\nFROM enriched_geo_events\r\nWHERE $__timeFilter(timestamp)\r\nGROUP BY \"День недели\", \"Час\"\r\nORDER BY \"День недели\" ASC, \"Час\" ASC",
          "refId": "A"
        }
      ],
      "title": "Матрица активности по времени суток",
      "transformations": [
        {
          "id": "groupingToMatrix",
