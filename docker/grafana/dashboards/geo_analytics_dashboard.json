          },
          "pluginVersion": "4.17.0",
          "queryType": "table",
          "rawSql": "SELECT \r\n    toStartOfHour(e.timestamp) AS time,\r\n    \r\n    multiIf(\r\n        toHour(e.timestamp) >= 23 OR toHour(e.timestamp) <= 7, 'Дома',\r\n        toHour(e.timestamp) BETWEEN 10 AND 18 AND toDayOfWeek(e.timestamp) BETWEEN 1 AND 5, 'На работе',\r\n        'В пути / Транзит'\r\n    ) AS metric,\r\n    \r\n    count(DISTINCT e.imsi) AS \"Количество людей\"\r\nFROM enriched_geo_events AS e\r\nWHERE $__timeFilter(e.timestamp)\r\nGROUP BY time, metric\r\nORDER BY time ASC",
          "refId": "A"
        }
      ],
      "title": "Пульс города",
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "metric"
            ],
            "keepFields": false
          }
        }
      ],
      "type": "timeseries"
    },
