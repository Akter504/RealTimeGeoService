          "pluginVersion": "4.16.0",
          "queryType": "table",
          "rawSql": "SELECT \r\n    p.poi_name AS name,\r\n    countIf(e.durationSec < 300) AS \"Прошли мимо\",\r\n    countIf(e.durationSec >= 300) AS \"Целевые визиты\"\r\nFROM enriched_geo_events AS e\r\nCROSS JOIN dict_poi_external AS p\r\nWHERE geoDistance(e.longitude, e.latitude, p.longitude, p.latitude) <= p.radius_meters\r\n  AND $__timeFilter(e.timestamp)\r\nGROUP BY name\r\nORDER BY (\"Целевые визиты\" + \"Прошли мимо\") DESC\r\nLIMIT 10",
          "refId": "A"
        }
      ],
